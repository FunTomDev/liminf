{
    "builds": [{
        "src": "backend/app/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "15mb", "runtime": "python3.10" }
    }],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "backend/app/wsgi.py"
        }

    ],
    "installCommand": "poetry install && npm install",
    "buildCommand": "poetry install && npm run build && python manage.py collectstatic --noinput"

}